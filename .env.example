# =============================================================================
# JJ Smith landing (jjsmithonline-com) — public env
# Copy to .env and fill in values. Never commit secrets.
# Vite only exposes VITE_* to the browser.
# =============================================================================

# Yobody / YoPlatform API (Nest unwraps { data } envelopes).
# Local: http://localhost:4000
# Prod:  https://api.yoplatform.ai
VITE_API_URL=http://localhost:4000

# Canonical Yobody signup resume URL (post-pay onboarding).
VITE_YOBODY_SIGNUP_URL=https://app.yobody.ai/signup
VITE_YOBODY_AUTH_URL=https://app.yobody.ai/auth

# Public Stripe key. Lovable config endpoint is preferred at runtime;
# this is the fallback used if that request fails.
VITE_STRIPE_PUBLISHABLE_KEY=

# Same Meta Pixel as Yobody signup (browser events only — no CAPI token here).
VITE_META_PIXEL_ID=920675803850327
# VITE_META_PIXEL_DEBUG=true

# Reserved for a later Google SSO step on the in-page card.
VITE_GOOGLE_CLIENT_ID=

# Existing voice demo keys (keep in .env; not required for checkout).
# VITE_VAPI_PUBLIC_KEY=
# VITE_VAPI_ASSISTANT_ID=
